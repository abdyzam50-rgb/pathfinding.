{
  "schemaVersion": 1,
  "id": "aotvloader",
  "version": "${version}",
  "name": "AOTV Loader",
  "description": "Keeps AOTV Pathfinder up to date. Fetches the current build each launch and installs it at the start of the next one.",
  "authors": [
    "abdyzam50"
  ],
  "contact": {
    "sources": "https://github.com/abdyzam50-rgb/pathfinding."
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "preLaunch": [
      "com.abdy2.aotvloader.Installer"
    ],
    "client": [
      "com.abdy2.aotvloader.AotvLoader"
    ]
  },
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=26.2",
    "java": ">=25"
  }
}
